<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchDedicatedWakeWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voice_dedicated_wakeword_label" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voice_access_key_label" />

        <EditText
            android:id="@+id/etPorcupineAccessKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/voice_access_key_hint"
            android:inputType="textNoSuggestions"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/tvWakeSensitivityValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sensitivity: 0.60" />

        <SeekBar
            android:id="@+id/seekWakeSensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="60" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchAutoStartVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voice_auto_start_label" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchPreferOfflineCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/voice_prefer_offline_command_label" />

        <Button
            android:id="@+id/btnSaveVoiceSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save_voice_settings" />
    </LinearLayout>
</ScrollView>
